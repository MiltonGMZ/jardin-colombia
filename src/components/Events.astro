---
const events = [
  { name: 'Grados', img: '/media/images/grados.jpg' },
  { name: 'Toyota', img: '/media/images/toyota.jpg' },
  { name: 'Playa', img: '/media/images/playa.jpg' },
  { name: 'Playa 2', img: '/media/images/playa-2.jpg' },
  { name: '15 años', img: '/media/images/15-anos.jpg' },
  { name: 'Primera comunión', img: '/media/images/primera-comunion.jpg' },
];
---
<section class="events" id="eventos">
  <div class="wrap events__head" data-reveal>
    <p class="eyebrow events__eyebrow">06 · Eventos</p>
    <h2 class="events__title">Eventos que florecen.</h2>
    <p class="events__body">
      Hemos sido parte de eventos especiales, aportando diseño floral y
      ambientación que realzan cada celebración con elegancia y
      naturalidad.
    </p>
  </div>

  <div class="events__grid wrap" data-reveal>
    {events.map((e, i) => (
      <div class={`events__item events__item--${i % 3}`}>
        <img src={e.img} alt={e.name} loading="lazy" />
      </div>
    ))}
  </div>
</section>

<style>
  .events { padding: clamp(80px, 10vw, 140px) 0; background: var(--forest); color: var(--paper); }
  .events__head { max-width: 60ch; margin-bottom: clamp(40px, 6vw, 64px); }
  .events__eyebrow { color: var(--mango); margin-bottom: 18px; }
  .events__title { font-size: clamp(2.1rem, 4.4vw, 3.4rem); margin-bottom: 16px; }
  .events__body { opacity: .82; margin: 0; }

  .events__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
  }
  .events__item { border-radius: 16px; overflow: hidden; }
  .events__item img { width: 100%; height: 100%; object-fit: cover; }
  .events__item--0 { grid-column: span 2; aspect-ratio: 1/1; }
  .events__item--1 { grid-column: span 2; aspect-ratio: 1/1; margin-top: 26px; }
  .events__item--2 { grid-column: span 2; aspect-ratio: 1/1; }

  @media (max-width: 760px) {
    .events__grid { grid-template-columns: repeat(2, 1fr); }
    .events__item { grid-column: span 1 !important; margin-top: 0 !important; aspect-ratio: 1/1; }
  }
</style>
